NODE_ENV=development
PORT=9000
CLIENT_URL=http://localhost:5173
MONGODB_URL=
JWT_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/google/callback

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments ----
# "flutterwave" (default, works worldwide incl. Nigeria) or "stripe"
PAYMENT_PROVIDER=flutterwave
CURRENCY=USD

# Flutterwave (dashboard > Settings > API). Use test keys while developing.
FLW_SECRET_KEY=
# A value YOU choose; paste the same string in dashboard > Settings > Webhooks > Secret hash
FLW_SECRET_HASH=

# Only needed when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SEED_PASSWORD=

# ---- new in this phase ----
# Prices are stored in this currency; shoppers see/pay converted amounts
# Currencies customers can actually be charged in (must be enabled on your Flutterwave account)
CHARGE_CURRENCIES=NGN,USD,GBP,EUR,GHS,KES,ZAR,UGX,TZS,RWF,XOF,XAF

# Wallet
PLATFORM_FEE_PERCENT=10
MIN_WITHDRAWAL=10

# Fraud rules
FRAUD_HIGH_VALUE=1000
FRAUD_BLOCK_SCORE=90

# Optional: enables the Claude-powered shopping assistant (falls back to rule-based answers without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Seller earnings are released when the buyer confirms receipt, or this many days after delivery
PAYOUT_HOLD_DAYS=3
