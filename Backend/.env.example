NODE_ENV=production
PORT=9000
CLIENT_URL=https://aliexpress-ecommapp-demo-abiola-olatunji.onrender.com
BACKEND_URL=https://flashxpress-ecommapp-backend.onrender.com
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
COOKIE_SECURE=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://flashxpress-ecommapp-backend.onrender.com/auth/google/callback
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
FLW_PUBLIC_KEY=your_flutterwave_public_key
FLW_SECRET_KEY=your_flutterwave_secret_key
FLW_SECRET_HASH=your_flutterwave_secret_hash
CURRENCY=USD

# ---- Payments ----
# "flutterwave" (default, works worldwide incl. Nigeria) or "stripe"
PAYMENT_PROVIDER=flutterwave
CURRENCY=USD

# Flutterwave (dashboard > Settings > API). Use test keys while developing.
FLW_SECRET_KEY=
# A value YOU choose; paste the same string in dashboard > Settings > Webhooks > Secret hash
FLW_SECRET_HASH=

# Only needed when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SEED_PASSWORD=

# ---- new in this phase ----
# Prices are stored in this currency; shoppers see/pay converted amounts
# Currencies customers can actually be charged in (must be enabled on your Flutterwave account)
CHARGE_CURRENCIES=NGN,USD,GBP,EUR,GHS,KES,ZAR,UGX,TZS,RWF,XOF,XAF

# Wallet
PLATFORM_FEE_PERCENT=10
MIN_WITHDRAWAL=10

# Fraud rules
FRAUD_HIGH_VALUE=1000
FRAUD_BLOCK_SCORE=90

# Optional: enables the Claude-powered shopping assistant (falls back to rule-based answers without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Seller earnings are released when the buyer confirms receipt, or this many days after delivery
PAYOUT_HOLD_DAYS=3
